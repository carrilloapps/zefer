{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.1.1",
        "--isolated"
      ]
    },
    "skill-rules": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "skill-rules@0.3.0",
        "mcp"
      ]
    }
  }
}
